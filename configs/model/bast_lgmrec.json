{
  "model": {
    "dim": 64,
    "layers": 1,
    "eta": 0.2,
    "alpha": 0.2,
    "beta": 0.1,
    "kappa": 2.0,
    "tau": 1.0,
    "learned_group": true,
    "compensation": true,
    "quality_mode": "full"
  },
  "training": {
    "seed": 2026,
    "epochs": 100,
    "batch_size": 256,
    "learning_rate": 0.001,
    "l2_weight": 1e-05,
    "dropout": 0.1,
    "patience": 10,
    "selection_metric": "recall@20",
    "user_batch": 128,
    "item_chunk": 4096,
    "device": "cpu",
    "test_mask_valid": false,
    "protocol": "mtmt",
    "evaluation_population": "train_users_only",
    "metrics": [
      "recall",
      "ndcg",
      "precision",
      "map"
    ],
    "cutoffs": [
      5,
      10,
      20,
      50
    ]
  }
}
